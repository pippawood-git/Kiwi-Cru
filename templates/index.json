        "usp_p3hdmT": {
          "type": "usp",
          "settings": {
            "usp_icon": "shopify://shop_images/kiwi-3-sun_B.png",
            "usp_heading": "Why Organic Matters",
            "text": "<p>Organic and biodynamic winemaking puts care at the centre - of farming, of flavour, and of future thinking. It’s better for the land, the wine, and the people who share it.</p>"
          }
        },
        "usp_Dfgc6V": {
          "type": "usp",
          "settings": {
            "usp_icon": "shopify://shop_images/svg_kiwi-6-sun_c64d86b7-6932-4152-81f1-6995e630c6e5.svg",
            "usp_heading": "In Partnership With Nature",
            "text": "<p>No intervention, no shortcuts. Just healthy soils, thriving ecosystems, and vineyards full of life.<em> (Did you know 96% of NZ vineyards are sustainably certified?).</em></p>"
          }
        },
        "usp_aeGwA6": {
          "type": "usp",
          "settings": {
            "usp_icon": "shopify://shop_images/kiwi-2-sun_49f78377-2664-4dfe-8f5f-c2f05f78668c.svg",
            "usp_heading": "A Movement Taking Root",
            "text": "<p>Across NZ, a number of winemakers are working organically, biodynamically, & regeneratively - crafting wines with a sense of place and the season which shaped them.</p>"
          }
        },
        "usp_C8Y8TR": {
          "type": "usp",
          "settings": {
            "usp_icon": "shopify://shop_images/kiwi-1-sun_21f25161-aa6e-40dd-b788-61877cef62b9.svg",
            "usp_heading": "Meet The Makers",
            "text": "<p>We partner with producers who farm with intention and humility – people who see wine as a reflection of their values, not just a product. You can taste the difference.</p>"
          }
        },
        "button_tx89EM": {
