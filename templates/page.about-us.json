    "rich_text_MKKnyU": {
      "type": "rich-text",
      "blocks": {
        "heading_BYQBqh": {
          "type": "heading",
          "settings": {
            "heading": "Kia ora, and welcome to Kiwi Cru!",
            "heading_style": "script",
            "heading_size": "h2",
            "highlight_style": "none",
            "enable_highlight_text_color": false
          }
        },
        "text_MLD3UQ": {
          "type": "text",
          "settings": {
            "text": "<p>We’re a specialist retailer and event provider, bringing lesser-known, high-quality New Zealand wines to the UK.</p><p>Through our Wine Club and tasting events, we help customers discover the hidden gems of Aotearoa’s wine world - wines made with care, character, and a strong sense of place.</p><p>We love wine, full stop. But our real passion is New Zealand. We’ve explored the country’s wine regions from top to bottom - visiting vineyards, meeting the people behind the wines, and tasting the bottles you won’t find everywhere else. </p><p>Now, we’re excited to share them with you.</p>",
            "highlight_style": "none"
          }
        }
      },
      "block_order": [
        "heading_BYQBqh",
        "text_MLD3UQ"
