    "custom_content_8jMkTb": {
      "type": "custom-content",
      "blocks": {
        "image_card_P3JcLF": {
          "type": "image_card",
          "settings": {
            "layout": "layout7",
            "text_color": "#000000",
            "image": "shopify://shop_images/DSC01198_f2575fdb-f019-4f7d-a219-bc78824c10bc.jpg",
