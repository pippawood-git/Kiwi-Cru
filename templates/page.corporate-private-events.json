    "image_with_usp_B63fa4": {
      "type": "image-with-usp",
      "blocks": {
        "heading_Wm9FaV": {
          "type": "heading",
          "settings": {
            "heading": "What To Expect",
            "heading_flourish": false,
            "heading_underline": "pistachio"
          }
        },
        "usp_LAxYzd": {
          "type": "usp",
          "settings": {
            "usp_icon": "shopify://shop_images/kiwi-6-sun_2eeb3b18-b005-4423-a788-c9a4326ccef1.png",
            "usp_heading": "Expert Hosting",
            "text": "<p>Your tasting will be led by a certified, experienced wine host - someone who knows their stuff but keeps things relaxed and engaging. No lectures, no jargon - just great wines, good conversation, and plenty of interesting facts along the way.</p>"
          }
        },
        "usp_cqEMJb": {
          "type": "usp",
          "settings": {
            "usp_icon": "shopify://shop_images/kiwi-3-sun_5419b2fd-e8e6-4ca7-9dcb-ce0ec36f5297.png",
            "usp_heading": "Tailored to You",
            "text": "<p>We work with a wide range of producers - from small, independent wineries to some of New Zealand’s most iconic vineyards. You choose the styles, varietals or regions you’re most curious about, and we’ll create a lineup to match.<br/><br/><br/><br/></p>"
          }
        },
        "usp_BcXwDf": {
          "type": "usp",
          "settings": {
            "usp_icon": "shopify://shop_images/kiwi-2-sun_39fc83fe-79b9-4b4b-ba7c-1d2506162e27.png",
            "usp_heading": "Everything Provided",
            "text": "<p>We’ll bring everything you need: tasting glasses, wine maps, and tasting sheets. All you have to do is take your seat and enjoy!<br/><br/><br/><br/></p>"
          }
        },
        "usp_kjhnNw": {
          "type": "usp",
          "settings": {
            "usp_icon": "shopify://shop_images/kiwi-1-sun_21f25161-aa6e-40dd-b788-61877cef62b9.svg",
            "usp_heading": "Interactive and Fun",
            "text": "<p>Expect a relaxed, sociable experience lasting around 60 - 90 minutes. We encourage everyone to get involved - questions, comments, even a little friendly competition (Yes, there’s wine to be won!)</p>"
          }
        }
      },
