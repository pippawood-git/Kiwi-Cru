{% if section.index > 2 %}
  <link rel="stylesheet" href="{{ 'multicolumn.css' | asset_url }}" media="print" onload="this.media='all'">
{% else %}
  {{ 'multicolumn.css' | asset_url | stylesheet_tag }}
{% endif %}
{% liquid
  assign section_id = section.settings.custom_id | default: section.id
  assign custom_class = section.settings.custom_class

  unless custom_class == blank
    assign custom_class = custom_class | prepend: ' '
  endunless

  assign container = section.settings.container
  assign columns = section.settings.columns

  assign enable_swipe_mobile = section.settings.enable_swipe_mobile
  assign medium_cols = columns
  if columns < 3 or request.design_mode
    assign medium_cols = columns
  endif
  assign layout = section.settings.layout

  assign enable_slider = false
  if enable_swipe_mobile and request.design_mode
    assign enable_slider = true
  endif

  assign animation_effect = settings.animations
  assign animated = false
  if animation_effect != 'none'
    assign animated = true
    if section.settings.animations != 'inherit'
      assign animation_effect = section.settings.animations
    endif
  endif

  assign swiper_class = ''
  if enable_swipe_mobile
    assign swiper_class = ' f-swiper f-swiper--no-scrollbar f-swiper--' | append: section.settings.column_mobile | append: '-cols'
    if columns == 3
      assign swiper_class = swiper_class | append: ' lg-down-swiper'
    endif
  endif
%}

<div
  id="{{ section_id }}"
  class="f-multicolumn{{ custom_class }} f-section-padding color-{{ section.settings.color_schema }}"
  style="--section-padding-top: {{ section.settings.padding_top }}px ; --section-padding-bottom: {{ section.settings.padding_bottom }}px; --section-padding-top-mobile: {{ section.settings.padding_top_mobile }}px; --section-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px; --column-gap:{{ section.settings.column_gap }}rem;"
>
  <div class="{{ container }}">
    {% render 'index-section-header',
      animation_effect: animation_effect,
      section_settings: section.settings,
      spacing: section.settings.section_header_padding_bottom,
      header_alignment: section.settings.header_alignment,
      header_alignment_mobile: section.settings.header_alignment
    %}
    <flickity-component
      class="f-grid f-grid-{{ section.settings.column_mobile }}-cols md:f-grid-{{ medium_cols }}-cols lg:f-grid-{{ columns }}-cols sm:f-grid--row-gap-{{ section.settings.row_gap_mobile }} sm:f-grid--gap-{{ section.settings.column_gap_mobile }} f-grid--row-gap-{{ section.settings.row_gap }} f-grid--gap-{{ section.settings.column_gap }}{% if enable_slider %} flickity-enable md:flickity-disable{% else %} flickity-disable{% endif %}{{ swiper_class }}"
      data-slider-options='{"groupCells": 2, "cellSelector": ".f-column", "contain": true, "wrapAround": true}'
      data-slider-columns="2"
      data-enable-slider="{{ enable_slider }}"
    >
      {% liquid
        assign raw_handles = section.settings.exclude_handles | newline_to_br
        assign lines = raw_handles | split: '<br />'
        assign handle_string = ''

        for line in lines
          assign clean_line = line | strip
          unless clean_line == ''
            if handle_string != ''
              assign handle_string = handle_string | append: ',' | append: clean_line
            else
              assign handle_string = clean_line
            endif
          endunless
        endfor

        assign excluded_handles = handle_string | split: ','
      %}

      {% paginate shop.metaobjects.winery.values by 200 %}
        {%- for winery in shop.metaobjects.winery.values -%}
          {% assign winery_handle = winery.winery_name | handleize %}
          {% unless excluded_handles contains winery_handle %}
            {% liquid
              assign image = winery.image_2 | default: winery._image_1
              assign image_link = winery.link
              assign tag = 'div'
              if image_link != blank
                assign tag = 'a'
              endif
            %}
            <div class="f-column">
              <div
                class="multicolumn-card multicolumn-card--{{ layout }} multicolumn-card--image-{{ section.settings.image_width }}{% if animated %} f-scroll-trigger animate--{{ animation_effect }}{% endif %}"
                {% if animated %}
                  data-cascade
                  style="--animation-order: {{ forloop.index }};"
                {% endif %}
              >
                <div class="multicolumn-card__inner flex flex-col text-{{ section.settings.text_alignment }}">
                  {% if image != blank %}
                    {% liquid
                      assign desktop_image_classes = ''
                    %}
                    <{{ tag }}
                      {% if image_link != blank %}
                        aria-label="{{ 'accessibility.read_more' | t: title: winery.winery_name }}"
                        href="{{ image_link | escape }}"
                      {% endif %}
                      class="multicolumn-card__image{% if image_link != blank %} f-image-hover-effect__{{settings.image_hover_effect}}{% endif %}"
                      >
                      {% render 'responsive-image',
                        image: image,
                        alt: winery.winery_name,
                        section_index: section.index,
                        index: forloop.index,
                        inheritedclasses: desktop_image_classes,
                        aspect_ratio: "3/2"
                      %}
                    </{{ tag }}>
                  {% endif %}
                  <div class="multicolumn-card__info{% if image != blank %} has-image{% endif %}">
                    {%- if winery.winery_name != blank -%}
                      <h3 class="h6">{{ winery.winery_name | escape }}</h3>
                    {%- endif -%}
                  </div>
                </div>
              </div>
            </div>
          {% endunless %}
        {%- endfor -%}
      {% endpaginate %}
    </flickity-component>
  </div>
</div>

