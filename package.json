{
  "name": "285b63-ef",
  "version": "0.1.0",
  "description": "Kiwi Cru Shopify Theme",
  "scripts": {
    "start": "run-s shopify:dev",
    "shopify:dev": "shopify theme dev --store 285b63-ef.myshopify.com",
    "deploy": "shopify theme push --store 285b63-ef.myshopify.com",
    "deploy:new": "shopify theme push --store 285b63-ef.myshopify.com --unpublished",
    "deploy:live": "shopify theme push --store 285b63-ef.myshopify.com --live",
    "shopify:pull": "shopify theme pull --store 285b63-ef.myshopify.com",
    "shopify:pull:customizer": "shopify theme pull --store 285b63-ef.myshopify.com --only=\"config/settings_data.json\" --only=\"templates/*.json\" --only=\"sections/*.json\" --only=\"layout/*.json\"",
    "shopify": "shopify",
    "lint": "run-s -c lint:*",
    "lint:shopify": "shopify theme check",
    "lint:shopify:fix": "shopify theme check --auto-correct",
    "lint:prettier": "prettier --list-different --ignore-unknown .",
    "lint:prettier:staged": "prettier --check --ignore-unknown",
    "prepare": "husky",
    "prettier-formatter-gitlab": "prettier-formatter-gitlab"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "author": "AYKO Digital Limited",
  "devDependencies": {
    "@shopify/prettier-plugin-liquid": "^1.5.0",
    "@shopify/stylelint-plugin": "^15.0.0",
    "@studiometa/prettier-formatter-gitlab": "^2.0.0",
    "husky": "^9.0.10",
    "lint-staged": "^15.2.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.3.3",
    "stylelint": "^16.10.0",
    "stylelint-config-standard": "^36.0.1",
    "stylelint-formatter-gitlab-code-quality-report": "^1.1.0",
    "stylelint-prettier": "^5.0.2"
  },
  "engines": {
    "npm": ">=10.0.0",
    "node": ">=20.0.0"
  },
  "dependencies": {
    "run-s": "^0.0.0"
  }
}
