{
  "defaultSeverity": "warning",
  "extends": ["@shopify/stylelint-plugin", "@shopify/stylelint-plugin/prettier", "stylelint-prettier/recommended"],
  "plugins": ["stylelint-prettier"],
  "rules": {
    "prettier/prettier": [
      true,
      {
        "trailingComma": "none"
      }
    ],
    "selector-class-pattern": null,
    "rule-empty-line-before": null,
    "selector-max-compound-selectors": 5,
    "selector-max-specificity": "2,5,1",
    "selector-max-class": 5,
    "at-rule-empty-line-before": null,
    "comment-empty-line-before": null,
    "selector-max-type": [3, { "ignore": ["child", "compounded", "custom-elements", "descendant", "next-sibling"] }],
    "selector-max-combinators": 5,
    "selector-type-no-unknown": null,
    "selector-no-qualifying-type": null,
    "selector-max-id": 2,
    "selector-max-attribute": 2,
    "order/properties-order": null,
    "selector-id-pattern": null,
    "color-no-hex": null,
    "color-hex-length": null,
    "comment-whitespace-inside": null,
    "declaration-no-important": null,
    "no-unknown-animations": null,
    "value-keyword-case": null,
    "selector-type-case": null,
    "declaration-property-value-disallowed-list": null
  }
}
